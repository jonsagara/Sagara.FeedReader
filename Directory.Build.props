<Project>
	<PropertyGroup>

		<!-- C# -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- LangVersion intentionally omitted: SDK infers the recommended C# version per TFM -->

		<!--
			Versioning: Sagara.Build.Versioning (GlobalPackageReference in Directory.Packages.props) computes
			Version, AssemblyVersion (Major.Minor.0.0), and FileVersion from these.
			- Set PrereleaseLabel to one of preview (default), alpha, beta, or rc for a pre-release version.
			  Comment it out for a stable release.
			- Set PreviewNumber to a positive integer for a pre-release version. Comment it out for a stable release.
			Do not set Version, AssemblyVersion, or FileVersion directly.
		-->
		<VersionPrefix>3.0.2</VersionPrefix>
		<!--<PrereleaseLabel>preview</PrereleaseLabel>
		<PreviewNumber>1</PreviewNumber>-->
		
		<!-- NuGet -->
		<Authors>Armin Reiter; Jon Sagara</Authors>
		<Copyright>Copyright 2022-2026</Copyright>
		<RepositoryUrl>https://github.com/jonsagara/Sagara.FeedReader</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/jonsagara/Sagara.FeedReader</PackageProjectUrl>

		<!-- 
			This is really helpful for larger projects, but I leave it in anyway. Why build if you don't have to? 
			
			See: https://devblogs.microsoft.com/visualstudio/vs-toolbox-accelerate-your-builds-of-sdk-style-net-projects/
		-->
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		
	</PropertyGroup>
</Project>
